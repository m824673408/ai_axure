{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-workspace.local/schemas/product.schema.json",
  "title": "Prototype Workspace Product Model",
  "description": "product/product.yaml。对应运行时校验 src/schema.ts 的 checkProductSchema。",
  "x-schema-version": 1,
  "type": "object",
  "required": ["product", "modules"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1, "description": "产物 schema 版本，可省略（省略视为 1）" },
    "product": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "description": "模块 id 唯一；被 routes.<id>.module 与 navigation 项引用",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
